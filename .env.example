# ---------------------------------------------------------------------------
# TeTe — Nimiq Pay Mini App
#
# Every variable here is PUBLIC: it is inlined into the browser bundle that
# ships to the Nimiq Pay WebView. Never put a secret in this file.
# All variables are optional — the app runs without any of them.
# ---------------------------------------------------------------------------

# Nimiq JSON-RPC endpoint (optional).
#
# The Mini App Nimiq provider exposes listAccounts / sign / consensus / block
# height / send*Transaction, but NO balance method. With this set, TeTe reads
# the real on-chain balance via the provider's RPC routing
# (`getAccountByAddress`). Without it, the balance is shown as unavailable —
# TeTe never displays a placeholder number.
#
# Public endpoints: https://nimiq.dev/rpc/open-servers
# (not production-grade; run your own node for production)
# NEXT_PUBLIC_NIMIQ_RPC_URL=https://your-albatross-node.example/

# Which network the RPC endpoint above points at: mainnet | testnet
# Informational only — a Mini App cannot query which network the wallet uses.
# NEXT_PUBLIC_NIMIQ_NETWORK=testnet

# Public HTTPS origin of this deployment. Used to render the Nimiq Pay
# deeplink on the desktop fallback screen. Falls back to window.location.origin.
# NEXT_PUBLIC_APP_URL=https://tete.example.app

# Preferred chain for the USDT stake path, as a hex chain id.
# Polygon 0x89 | Ethereum 0x1 | Arbitrum 0xa4b1 | Optimism 0xa
# NEXT_PUBLIC_EVM_DEFAULT_CHAIN_ID=0x89

# Optional intro footage played after connecting. Leave unset to use the
# built-in animated intro, which ships no video payload.
# NEXT_PUBLIC_INTRO_VIDEO=/intro.mp4

# Nimiq address deposits are sent to. Unset means the deposit screen refuses to
# send — funds sent to a wrong Nimiq address cannot be recovered, so there is
# deliberately no default here.
# NEXT_PUBLIC_TREASURY_NIM_ADDRESS=NQ.. .. .. ..
